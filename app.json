{
  "expo": {
    "name": "HalKhata",
    "slug": "halkhata",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "halkhata",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.halkhata.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.halkhata.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#EE161F"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.INTERNET"
      ]
    },
    "platforms": [
      "ios",
      "android"
    ],
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#EE161F",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "ios": {
            "backgroundColor": "#EE161F",
            "resizeMode": "contain"
          },
          "android": {
            "backgroundColor": "#EE161F",
            "resizeMode": "contain"
          }
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-file-system",
        {
          "supportsOpeningDocumentsInPlace": true,
          "enableFileSharing": true
        }
      ],
      "expo-document-picker",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3d7ae686-6a2f-42cc-b075-bf925ec7e0be"
      }
    },
    "owner": "anik_dev",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/3d7ae686-6a2f-42cc-b075-bf925ec7e0be"
    }
  }
}
